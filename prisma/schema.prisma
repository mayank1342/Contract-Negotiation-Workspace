datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  name             String
  role             String               @default("Freelancer")
  experience       String               @default("Intermediate")
  preferredStyle   String               @default("Professional")
  mainGoal         String               @default("Better contract value & lower risk")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  contracts        Contract[]
  negotiations     Negotiation[]
  userProgress     UserProgress?
  badges           Badge[]
  notifications    Notification[]
  templates        ContractTemplate[]
  permissions      ContractPermission[]
  comments         ContractComment[]
  activities       ContractActivity[]
}

// ─── Contract Template Library ────────────────────────────────────────────────

model ContractTemplate {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String             @default("General")
  description String             @default("")
  content     String             // full template text with {{VARIABLE}} placeholders
  fileUrl     String?            // path to uploaded file if any
  fileType    String?            // pdf, docx, txt
  isPublic    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  variables   TemplateVariable[]
  contracts   Contract[]
}

model TemplateVariable {
  id          String           @id @default(uuid())
  templateId  String
  template    ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key         String           // e.g. PARTY_1_NAME
  label       String           // e.g. "Party 1 Name"
  defaultVal  String           @default("")
  createdAt   DateTime         @default(now())
}

// ─── Contract (extended) ──────────────────────────────────────────────────────

model Contract {
  id              String               @id @default(uuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId      String?
  template        ContractTemplate?    @relation(fields: [templateId], references: [id])
  sourceType      String               @default("UPLOADED") // UPLOADED | FROM_TEMPLATE | WIZARD
  title           String
  type            String               @default("Employment Contract")
  content         String
  status          String               @default("DRAFT") // DRAFT, IN_REVIEW, NEGOTIATING, COMPLETED
  overallRisk     Int                  @default(50)
  financialRisk   Int                  @default(50)
  terminationRisk Int                  @default(50)
  liabilityRisk   Int                  @default(50)
  paymentRisk     Int                  @default(50)
  ipRisk          Int                  @default(50)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  clauses         Clause[]
  riskReports     RiskReport[]
  negotiations    Negotiation[]
  versions        ContractVersion[]
  parties         ContractParty[]
  permissions     ContractPermission[]
  comments        ContractComment[]
  activities      ContractActivity[]
}

model ContractVersion {
  id                String   @id @default(uuid())
  contractId        String
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionNumber     Int
  title             String
  content           String
  riskScore         Int      @default(50)
  changedBy         String   @default("") // user name who made the change
  changeDescription String   @default("") // human description of what changed
  createdAt         DateTime @default(now())
}

model Clause {
  id                   String   @id @default(uuid())
  contractId           String
  contract             Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title                String
  text                 String
  category             String   @default("General")
  riskLevel            String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  simpleExplanation    String
  proExplanation       String
  studentExplanation   String
  whyItMatters         String
  suggestedImprovement String
  negotiationStrategy  String
  status               String   @default("REVIEW") // ACCEPTED, FLAGGED, REWRITTEN
  createdAt            DateTime @default(now())
}

model RiskReport {
  id             String   @id @default(uuid())
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  riskType       String
  level          String   // LOW, MEDIUM, HIGH
  title          String
  description    String
  recommendation String
  createdAt      DateTime @default(now())
}

model Negotiation {
  id             String                @id @default(uuid())
  contractId     String
  contract       Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  opponentRole   String                @default("HR Manager")
  opponentStyle  String                @default("Professional") // Friendly, Professional, Aggressive, Difficult
  userRole       String                @default("Candidate")
  goal           String                @default("Maximize total package & fair terms")
  targetValue    Float                 @default(75000)
  minimumValue   Float                 @default(65000)
  batnaValue     Float                 @default(68000)
  zopaMin        Float                 @default(65000)
  zopaMax        Float                 @default(85000)
  status         String                @default("ACTIVE") // ACTIVE, AGREED, FAILED
  overallScore   Int?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  messages       NegotiationMessage[]
  offers         Offer[]
  concessions    Concession[]
  score          NegotiationScore?
  replay         NegotiationReplay?
}

model NegotiationMessage {
  id            String      @id @default(uuid())
  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  sender        String      // USER, OPPONENT, SYSTEM, COACH
  text          String
  roundNumber   Int         @default(1)
  createdAt     DateTime    @default(now())
}

model Offer {
  id            String      @id @default(uuid())
  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  roundNumber   Int
  offerBy       String      // USER, OPPONENT
  salary        Float
  duration      String      @default("1 Year")
  noticePeriod  String      @default("30 Days")
  paymentTerms  String      @default("30 Days")
  status        String      @default("PENDING") // PENDING, COUNTERED, ACCEPTED, REJECTED
  createdAt     DateTime    @default(now())
}

model Concession {
  id            String      @id @default(uuid())
  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  roundNumber   Int
  madeBy        String      // USER, OPPONENT
  description   String
  valueGained   Float       @default(0)
  valueGiven    Float       @default(0)
  createdAt     DateTime    @default(now())
}

model NegotiationScore {
  id                 String      @id @default(uuid())
  negotiationId      String      @unique
  negotiation        Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  overallScore       Int
  communicationScore Int
  preparationScore   Int
  priceScore         Int
  riskScore          Int
  concessionScore    Int
  strategyScore      Int
  strengths          String      // JSON array string
  weaknesses         String      // JSON array string
  valueSaved         Float       @default(0)
  createdAt          DateTime    @default(now())
}

model NegotiationReplay {
  id            String      @id @default(uuid())
  negotiationId String      @unique
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  roundData     String      // JSON string of rounds
  insights      String      // JSON string of round insights
  createdAt     DateTime    @default(now())
}

model Workshop {
  id          String           @id @default(uuid())
  title       String
  description String
  category    String           @default("Foundations")
  lessonCount Int              @default(5)
  createdAt   DateTime         @default(now())

  lessons     WorkshopLesson[]
}

model WorkshopLesson {
  id          String             @id @default(uuid())
  workshopId  String
  workshop    Workshop           @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  summary     String
  theory      String
  exampleText String
  createdAt   DateTime           @default(now())

  scenarios   WorkshopScenario[]
  quizzes     Quiz[]
}

model WorkshopScenario {
  id                String         @id @default(uuid())
  lessonId          String
  lesson            WorkshopLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title             String
  context           String
  userObjective     String
  opponentObjective String
  batna             String
  target            String
  minimum           String
  createdAt         DateTime       @default(now())
}

model Quiz {
  id            String         @id @default(uuid())
  lessonId      String
  lesson        WorkshopLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question      String
  options       String         // JSON array
  correctAnswer Int
  explanation   String
  createdAt     DateTime       @default(now())
}

model UserProgress {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp               Int      @default(0)
  level            Int      @default(1)
  currentStreak    Int      @default(1)
  completedLessons String   @default("[]") // JSON array string
  completedQuizzes String   @default("[]") // JSON array string
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Badge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey    String
  title       String
  description String
  icon        String   @default("Trophy")
  unlockedAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Multi-Party & Collaboration Models ──────────────────────────────────────

model ContractParty {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name       String
  email      String   @default("")
  company    String   @default("")
  role       String   @default("Party") // Party 1, Party 2, Legal Advisor, etc.
  order      Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContractPermission {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   @default("VIEWER") // OWNER, EDITOR, REVIEWER, COMMENTER, VIEWER
  invitedBy  String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContractComment {
  id          String            @id @default(uuid())
  contractId  String
  contract    Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId    String?           // null = top-level, set = reply
  clauseRef   String            @default("") // e.g. "clause:Payment Terms"
  content     String
  isResolved  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  replies     ContractComment[] @relation("CommentReplies")
  parent      ContractComment?  @relation("CommentReplies", fields: [parentId], references: [id])
}

model ContractActivity {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // CONTRACT_CREATED, CONTENT_EDITED, VERSION_CREATED, PARTY_ADDED, COMMENT_ADDED, AI_MODIFY_ACCEPTED, COLLABORATOR_INVITED, STATUS_CHANGED
  description String
  metadata    String   @default("{}") // JSON string for extra data
  createdAt   DateTime @default(now())
}
